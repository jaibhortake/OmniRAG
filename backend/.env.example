# real = local models via Ollama/HF ; fake = no-model demo/test mode
OMNIRAG_PROVIDERS=real
OMNIRAG_OLLAMA_HOST=http://localhost:11434
OMNIRAG_LLM_MODEL=qwen2.5:3b
OMNIRAG_VISION_MODEL=moondream
OMNIRAG_WHISPER_MODEL=small.en
# Optional: path to a Piper voice (.onnx). Empty = browser speech synthesis
OMNIRAG_PIPER_VOICE=
# Raise to refuse more often, lower to answer more often
OMNIRAG_RERANK_THRESHOLD=0.15
